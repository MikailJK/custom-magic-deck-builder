# --- Supabase (from your Supabase project's Settings > API page) ---
# Safe to expose to the browser — protected by Row Level Security, not secrecy.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Cloudflare R2 (server-side only — used by /api/r2-upload-url) ---
# Never prefix these with VITE_, or they'd be bundled into the browser build.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=drafting-table-images
# The bucket's public URL — either its free R2.dev "Public Development URL"
# (Cloudflare dashboard > R2 > your bucket > Settings > Public Access)
# or a custom domain you've connected. No trailing slash.
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
